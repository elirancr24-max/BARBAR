# ============================================
# Backend ENV — בר אברג׳יל API
# ============================================

# Server
NODE_ENV=development
PORT=4000
API_PREFIX=/api/v1

# ─── DATABASE ───
# LOCAL (SQLite, no Docker):
DATABASE_URL=file:./dev.db
# PRODUCTION (Supabase Postgres):
# DATABASE_URL=postgresql://postgres.xxx:[PWD]@aws-...supabase.com:6543/postgres

# ─── REDIS ───
# LOCAL (in-memory shim, no Redis needed):
REDIS_URL=memory://local
# PRODUCTION (Upstash):
# REDIS_URL=rediss://default:[TOKEN]@xxx.upstash.io:6379

# ─── JWT (use `openssl rand -hex 32` in production) ───
JWT_ACCESS_SECRET=dev-access-secret-please-change-in-prod-min-32chars-aaaa
JWT_REFRESH_SECRET=dev-refresh-secret-please-change-in-prod-min-32chars-bbbb
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ─── CORS (production: your Vercel URL) ───
CORS_ORIGIN=http://localhost:3000

# ─── Logging ───
LOG_LEVEL=debug

# ─── Payments ───
PAYMENT_PROVIDER=mock
TRANZILA_TERMINAL=
TRANZILA_SUPPLIER=

# ─── Business ───
BUSINESS_NAME=בר אברג׳יל Hair Design
BUSINESS_PHONE=972500000001
BUSINESS_TIMEZONE=Asia/Jerusalem
BUSINESS_ADDRESS=בניין העיגולים, אילת
